+            Đối tượng:
+          </span>
+          <div className={styles.options}>
+            {(['Tất cả', 'Cá nhân', 'Doanh nghiệp'] as const).map(value => (
+              <button
+                key={value}
+                type="button"
+                aria-pressed={audience === value}
+                disabled={kind === 'bundle' && value !== 'Doanh nghiệp'}
