+import type { GetStaticPaths, GetStaticProps } from 'next';
+import { PrimaryLayout } from '@/layouts';
+import type { NextPageWithLayout } from '../../_app';
+import {
+  products,
+  type AiProduct,
+} from '@/shared/features/page/AiAccountsPage/mockData';
+import { AiProductDetailPage } from '@/shared/features/page/AiAccountDetailPage/AiProductDetailPage';
+
+type Props = { product: AiProduct };
+const Page: NextPageWithLayout<Props> = ({ product }) => (
+  <PrimaryLayout
+    appearance="liquid-glass"
+    seo={{
+      title: `${product.name} | Printerval`,
+      canonical: `/tai-khoan-ai/goi/${product.id}`,
+    }}
+  >
+    <AiProductDetailPage product={product} />
+  </PrimaryLayout>
+);
+export const getStaticPaths: GetStaticPaths = async () => ({
+  paths: products
+    .filter(product => product.type === 'official')
+    .map(product => ({ params: { id: product.id } })),
+  fallback: false,
+});
+export const getStaticProps: GetStaticProps<Props> = async ({ params }) => {
+  const product = products.find(
+    item => item.id === params?.id && item.type === 'official',
+  );
+  return product ? { props: { product } } : { notFound: true };
+};
+export default Page;
