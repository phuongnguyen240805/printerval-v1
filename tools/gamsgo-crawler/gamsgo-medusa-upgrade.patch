+  assert.equal(fixture.products.length, 0);
+  assert.equal(fixture.preview.length, 4);
+  assert.equal(fixture.report.complete, false);
+  const live = buildMedusa(
+    records.map((r: any) => ({ ...r, crawl: { ...r.crawl, offline: false } })),
